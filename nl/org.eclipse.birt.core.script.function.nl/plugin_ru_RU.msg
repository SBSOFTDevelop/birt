#Properties file for org.eclipse.birt.core.script.bre
Bundle-Name.0 = Плагин функций

dataType.String=Строка

dataType.Any=Any

dataType.DateTime=DateTime
dataType.Integer=Integer

dataType.Double=Double

dataType.Number=Number

dataType.Boolean=Boolean

dataType.DoubleArray=Double[]

FunctionDesc.charLength=Возвращает количество символов в строке.

FunctionDesc.concat=Возвращает строку, составленную из указанных строк.

FunctionDesc.indexOf=Выполняет поиск цели в исходной строке и возвращает индекс первого вхождения шаблона.\nПоиск начинается с позиции start. Все значения индекса основаны на 0. Если \nstart опущен, предполагается значение 0.\nПоиск строк учитывает регистр.

FunctionDesc.left=Возвращает первые n символов строки str.\nЕсли 'n' равно 0, возвращается пустая строка.\nЕсли 'n' больше длины 'str', возвращается вся строка.\nЕсли 'n' не указан, используется значение 1.

FunctionDesc.right=Возвращает последние n символов строки str.\nЕсли 'n' равно 0, возвращается пустая строка. Если n больше длины str, возвращается вся строка.\nЕсли 'n' не указан, используется значение 1.

FunctionDesc.search=Аналогично функции indexOf. Отличия:\n(1) При сравнении строк регистр не учитывается.\n(2) Строка шаблона может содержать подстановочные знаки:\n* соответствует любой последовательности символов (включая пустую);\n? соответствует любому одиночному символу.

FunctionDesc.toLower=Преобразует символы в исходной строке в строчные буквы.

FunctionDesc.toUpper=Преобразует символы в исходной строке в заглавные буквы.

FunctionDesc.trim=Удаляет все ведущие и конечные пробелы (пробел, табуляция и т.д.).\nТакже объединяет все последовательные пробелы.

FunctionDesc.trimLeft=Удаляет все ведущие пробелы. Конечные пробелы и пробелы между словами не удаляются.

FunctionDesc.trimRight=Удаляет все конечные пробелы. Ведущие пробелы и пробелы между словами не удаляются.

FunctionDesc.anyOf=Источник находится в целевом диапазоне

FunctionDesc.between=TRUE, если источник находится между target1 и target2. В противном случае FALSE

FunctionDesc.notBetween=TRUE, если источник не находится между target1 и target2. В противном случае FALSE

FunctionDesc.equalTo=Источник равен цели

FunctionDesc.greaterThan=Источник больше цели

FunctionDesc.lessThan=Источник меньше цели

FunctionDesc.greaterOrEqual=Источник больше или равен цели

FunctionDesc.lessOrEqual=Источник меньше или равен цели

FunctionDesc.notEqual=Источник не равен цели

FunctionDesc.like=Источник соответствует шаблону цели SQL

FunctionDesc.notLike=Источник не соответствует шаблону цели SQL

FunctionDesc.match=Источник соответствует шаблону цели JavaScript

FunctionDesc.compareString=Сравнить две строки по указанным условиям

FunctionDesc.add=Сумма двух чисел n1 и n2.

FunctionDesc.substract=n1 вычесть n2

FunctionDesc.multiple=n1 умножить на n2. Эта функция используется только для обратной совместимости с функцией multiply.

FunctionDesc.multiply=n1 умножить на n2

FunctionDesc.divide=Делимое делится на делитель

FunctionDesc.round=Округляет число до указанного количества знаков.\ndec — целое число и может быть отрицательным.\nЗначение dec по умолчанию равно 0, если не указано.

FunctionDesc.roundUp=Округляет число от 0 в большую сторону до указанного количества знаков.\nЗначение dec по умолчанию равно 0.

FunctionDesc.roundDown=Округляет число от 0 в меньшую сторону до указанного количества знаков.\nЗначение dec по умолчанию равно 0.

FunctionDesc.ceiling=Округляет число от нуля до ближайшего кратного значению significance.

FunctionDesc.mod=Остаток от деления числа на делитель. Результат имеет тот же знак, что и делитель.

FunctionDesc.safeDivide=Если результат деления делимого на делитель не равен нулю или бесконечности, возвращается результат.\nЕсли значение равно 0, возвращается указанное значение.

FunctionDesc.year=4-значный год заданного значения даты/времени.

FunctionDesc.quarter=Номер квартала (от 1 до 4) заданного значения даты/времени.

FunctionDesc.month=Месяц/время. Option — целочисленное значение:\n1 (по умолчанию): возвращается номер месяца (1-12);\n2: возвращаются полные названия месяцев согласно локали пользователя (например, Январь — Декабрь для русской локали);\n3: возвращаются краткие названия месяцев согласно локали пользователя (например, Янв — Дек для русской локали)

FunctionDesc.week=Номер недели в году (от 1 до 52) значения даты/времени d.

FunctionDesc.day=Номер дня в месяце (от 1 до 31).

FunctionDesc.weekDay=День недели. Option — целочисленное значение\n1: возвращается число от 1 (воскресенье) до 7 (суббота);\n2: возвращается число от 1 (понедельник) до 7 (воскресенье);\n3: возвращается число от 0 (понедельник) до 6 (воскресенье);\n4: возвращается название дня недели согласно локали пользователя (например, Воскресенье — Суббота для русского);\n5: возвращается сокращенное название дня недели согласно локали пользователя (например, Вс — Сб для русского)

FunctionDesc.today=Возвращает значение метки времени, равное полуночи текущей даты.

FunctionDesc.now=Возвращает текущую метку времени.

FunctionDesc.diffYear=Возвращает разницу в количестве лет.

FunctionDesc.diffMonth=Возвращает разницу в количестве месяцев.

FunctionDesc.diffQuarter=Возвращает разницу в количестве кварталов.

FunctionDesc.diffWeek=Возвращает разницу в количестве недель.

FunctionDesc.diffDay=Возвращает разницу в количестве дней.

FunctionDesc.diffHour=Возвращает разницу в количестве часов.

FunctionDesc.diffMinute=Возвращает разницу в количестве минут.

FunctionDesc.diffSecond=Возвращает разницу в количестве секунд.

FunctionDesc.addYear=Добавить n год(а/ов) к дате

FunctionDesc.addMonth=Добавить n месяц(а/ев) к дате

FunctionDesc.addQuarter=Добавить n квартал(а/ов) к дате

FunctionDesc.addWeek=Добавить n неделю(и/ель) к дате

FunctionDesc.addDay=Добавить n день(дня/ей) к дате

FunctionDesc.addHour=Добавить n час(а/ов) к дате

FunctionDesc.addMinute=Добавить n минуту(ы/минут) к дате

FunctionDesc.addSecond=Добавить n секунду(ы/нд) к дате

FunctionDesc.firstDayOfYear=Возвращает первый день года, в который попадает дата.

FunctionDesc.firstDayOfQuarter=Возвращает первый день квартала, в который попадает дата.

FunctionDesc.firstDayOfMonth=Возвращает первый день месяца, в который попадает дата.

FunctionDesc.firstDayOfWeek=Возвращает первый день недели, в которую попадает дата.

FunctionDesc.ddb=Амортизация актива за указанный отдельный период с использованием метода двойного уменьшаемого остатка. Примечания

FunctionDesc.fv=Будущая стоимость аннуитета на основе регулярных, равных платежей и неизменной процентной ставки.

FunctionDesc.ipmt=Процентная выплата за указанный период аннуитета,\nна основе периодических, равных платежей и с неизменной процентной ставкой.

FunctionDesc.irr=Внутренняя норма доходности для ряда периодических денежных потоков (платежей и поступлений) в существующем массиве.

FunctionDesc.mirr=Модифицированная внутренняя норма доходности для ряда периодических денежных потоков (платежей и поступлений) в существующем массиве.

FunctionDesc.nper=Количество периодов для аннуитета на основе регулярных, равных платежей и неизменной процентной ставки.

FunctionDesc.npv=Текущая чистая стоимость изменяемого ряда денежных потоков (как положительных, так и отрицательных) по указанной процентной ставке.

FunctionDesc.percent=Вычисляет процентное соотношение двух чисел.

FunctionDesc.pmt=Платеж для аннуитета на основе регулярных, равных платежей и неизменной процентной ставки.

FunctionDesc.ppmt=Выплата основного долга за указанный период аннуитета на основе процентной ставки и постоянного графика платежей.

FunctionDesc.pv=Текущая стоимость аннуитета на основе регулярных, равных платежей, подлежащих выплате в будущем, и неизменной процентной ставки.

FunctionDesc.rate=Процентная ставка за период для аннуитета.

FunctionDesc.sln=Линейная амортизация актива за один период.

FunctionDesc.syd=Примечание к амортизации актива по методу суммы чисел лет за указанный период

FunctionDesc.addDate=Возвращает дату, полученную путем добавления лет, месяцев и дней к начальной дате.

FunctionDesc.addTime=Возвращает дату, полученную путем добавления часов, минут, секунд к начальной дате.

FunctionDesc.subDate=Возвращает дату, полученную путем вычитания лет, месяцев и дней из начальной даты.

FunctionDesc.subTime=Возвращает дату, полученную путем вычитания часов, минут, секунд из начальной даты.

FunctionDesc.days=Количество дней между двумя датами

FunctionDesc.hours=Количество часов между двумя датами

FunctionDesc.minutes=Количество минут между двумя датами

FunctionDesc.months=Количество месяцев между двумя датами

FunctionDesc.seconds=Количество секунд между двумя датами

FunctionDesc.years=Количество лет между двумя датами

FunctionDesc.date=Возвращает объект даты, инициализированный указанными годом, месяцем, днем, часами, минутами и секундами.\n(Год, месяц, день обязательны; часы, минуты, секунды необязательны)

FunctionDesc.duration.year=Получает значение поля YEARS как целое число, * или 0, если не указано.\nlexicalDuration — представление строки длительности 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)

FunctionDesc.duration.month=Получает значение поля MONTHS как целое число, * или 0, если не указано.\nlexicalDuration — представление строки длительности 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)

FunctionDesc.duration.day=Получает значение поля DAYS как целое число, * или 0, если не указано.\nlexicalDuration — представление строки длительности 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)

FunctionDesc.duration.hour=Получает значение поля HOURS как целое число, * или 0, если не указано.\nlexicalDuration — представление строки длительности 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)

FunctionDesc.duration.minute=Получает значение поля MINUTES как целое число, * или 0, если не указано.\nlexicalDuration — представление строки длительности 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)

FunctionDesc.duration.second=Получает значение поля SECONDS как целое число, * или 0, если не указано.\nlexicalDuration — представление строки длительности 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)

FunctionDesc.duration.timeInMills=Возвращает значение длительности в миллисекундах.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)\nАргумент startDate используется для однозначного определения этой вариации

FunctionDesc.duration.isLongerThan=Проверяет, всегда ли lexicalDuration1 длиннее lexicalDuration2.\nНапример, 'P1D' (один день) > 'PT12H' (12 часов) и 'P2Y' (два года) > 'P23M' (23 месяца)

FunctionDesc.duration.isShorterThan=Проверяет, всегда ли lexicalDuration1 короче lexicalDuration2.\nНапример: 'PT12H' (12 часов) < 'P1D' (один день).

FunctionDesc.duration.add=Возвращает значение длительности в миллисекундах.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S).

FunctionDesc.duration.substract=Вычисляет новую длительность, значение которой равно lexicalDuration1 - lexicalDuration2.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S).

FunctionDesc.duration.multiply=Вычисляет новую длительность, значение которой в factor раз больше значения lexicalDuration.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S).\nFactor — во сколько раз новая длительность больше

FunctionDesc.duration.negate=Возвращает новую длительность в миллисекундах, значение которой равно -lexicalDuration.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S).

FunctionDesc.duration.getSign=Возвращает знак длительности как -1, 0 или 1.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S).

FunctionDesc.duration.compare=Частичный порядок между lexicalDuration1 и lexicalDuration2.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)

FunctionDesc.duration.addTo=Добавляет эту длительность к объекту даты.\nlexicalDuration — представление строки 'PnYnMnDTnHnMnS' (например, P5Y2M15DT4H40M20S)\nАргумент startDate используется для однозначного определения этой вариации

FunctionDesc.format=Получает отформатированную строку из указанного объекта и шаблона.